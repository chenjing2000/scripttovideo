<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScriptToVideo</AssemblyName>
    <RootNamespace>ScriptToVideo</RootNamespace>
    <ApplicationIcon>assets/app.ico</ApplicationIcon>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <!-- Rebuild the WebView2 UI before MSBuild captures embedded resource filenames.
       A plain dotnet publish must never reuse an older dist/ bundle. -->
  <Target Name="BuildEmbeddedWebUi" BeforeTargets="AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/.." />
    <ItemGroup>
      <EmbeddedResource Include="../dist/index.html" LogicalName="TSUI/index.html" />
      <EmbeddedResource Include="../dist/app.ico" LogicalName="TSUI/app.ico" />
      <!-- Separate item type prevents target batching against unrelated TSRUNTIME resources. -->
      <BuiltWebAsset Include="../dist/assets/**/*" />
    </ItemGroup>
    <ItemGroup>
      <!-- Apply metadata after item discovery, when Filename/Extension are available. -->
      <BuiltWebAsset Update="@(BuiltWebAsset)">
        <LogicalName>TSUI/assets/%(BuiltWebAsset.RecursiveDir)%(BuiltWebAsset.Filename)%(BuiltWebAsset.Extension)</LogicalName>
      </BuiltWebAsset>
      <EmbeddedResource Include="@(BuiltWebAsset)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <EmbeddedResource Include="../package.json" LogicalName="TSRUNTIME/package.json" />
    <EmbeddedResource Include="../package-lock.json" LogicalName="TSRUNTIME/package-lock.json" />
    <EmbeddedResource Include="../tsconfig.json" LogicalName="TSRUNTIME/tsconfig.json" />
    <EmbeddedResource Include="../scripts/ensure-browser.mjs" LogicalName="TSRUNTIME/scripts/ensure-browser.mjs" />
    <EmbeddedResource Include="../scripts/export.mjs" LogicalName="TSRUNTIME/scripts/export.mjs" />
    <EmbeddedResource Include="../scripts/cli-cache.mjs" LogicalName="TSRUNTIME/scripts/cli-cache.mjs" />
    <EmbeddedResource Include="../scripts/page-plan-validation.mjs" LogicalName="TSRUNTIME/scripts/page-plan-validation.mjs" />
    <EmbeddedResource Include="../scripts/script-to-video-contract.mjs" LogicalName="TSRUNTIME/scripts/script-to-video-contract.mjs" />
    <EmbeddedResource Include="../src/**/*" LogicalName="TSRUNTIME/src/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
